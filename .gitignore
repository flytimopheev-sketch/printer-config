# Build output (already built; kept for a self-contained checkout and the RPM)
dist/

# Node dependencies
node_modules/

# Rust build artifacts (large)
src-tauri/target/
src-tauri/debug/
src-tauri/release/

# Собранные дистрибутивы (релизы публикуются в GitHub Releases)
dist-rpm/
out/
*.rpm
*.msi
*.exe
*.AppImage
*.deb

# Local editor / tooling state
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# Logs and temp files
*.log
.DS_Store
*.tmp
tsconfig.tsbuildinfo

# Scratch debug artifacts from local builds (_*.err/_*.out/_*.rpm/_*.log)
_*.err
_*.out
_*.rpm
_diff*.txt
_parse_red.py

# Tauri app handle / secrets
src-tauri/generated/*
!src-tauri/generated/*.rs

# Tauri CLI generated schemas (build artifacts)
src-tauri/gen/

# Screenshots / scratch captures
*.b64
_shot*.png
final*.png
screenshot-*.png
