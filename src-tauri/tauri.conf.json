{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Printer Config",
  "version": "1.0.0",
  "identifier": "ru.printerconfig.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Printer Config",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm"],
    "category": "Utility",
    "shortDescription": "Современный frameless-менеджер принтеров",
    "longDescription": "Printer Config — современный frameless-менеджер принтеров на Rust/Tauri: очереди CUPS/IPP, mDNS-обнаружение сетевых принтеров, драйверы и политики печати.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "linux": {
      "rpm": {
        "depends": ["cups", "cups-client", "xdg-utils", "desktop-file-utils"]
      }
    }
  }
}
