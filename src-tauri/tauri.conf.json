{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Printer Config",
  "version": "1.2.7",
  "identifier": "ru.printerconfig.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Printer Config",
        "width": 920,
        "height": 620,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Менеджер принтеров и очередей печати",
    "longDescription": "Printer Config — настольный менеджер принтеров на Rust/Tauri: очереди CUPS/IPP, общий доступ, свойства принтера, управление заданиями и обнаружение сетевых принтеров по mDNS/DNS-SD.",
    "publisher": "flytimopheev-sketch",
    "homepage": "https://github.com/flytimopheev-sketch/printer-config",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "linux": {
      "rpm": {
        "depends": [
          "cups",
          "cups-client",
          "xdg-utils",
          "desktop-file-utils",
          "webkit2gtk4.1",
          "gsettings-desktop-schemas",
          "libnotify",
          "avahi"
        ]
      }
    }
  }
}
